{
  "name": "godot-mcp",
  "version": "0.2.0",
  "description": "MCP server for Godot: read/edit scenes and scripts, validate, run headless, and capture debug output for AI agents.",
  "keywords": [
    "godot",
    "mcp",
    "ai",
    "claude",
    "cline"
  ],
  "homepage": "https://github.com/xuxinzhi007/godot-mcp",
  "bugs": {
    "url": "https://github.com/xuxinzhi007/godot-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuxinzhi007/godot-mcp.git"
  },
  "license": "MIT",
  "author": "Solomon Elias <solomon@sippy.ai>",
  "type": "module",
  "bin": {
    "godot-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node scripts/build.js",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "probe": "node scripts/probe.mjs",
    "probe:smoke": "node scripts/probe.mjs scripts/smoke.plan.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "0.6.0",
    "axios": "^1.7.9",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "contributors": [
    {
      "name": "Solomon Elias",
      "note": "original godot-mcp by Coding-Solo"
    }
  ]
}
